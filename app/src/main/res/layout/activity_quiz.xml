<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#081120">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0D1B2A"
        android:padding="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/quizTopic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Topic"
            android:textColor="#4FC3F7"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/heartsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="❤️ ❤️ ❤️"
            android:textSize="20sp"/>

        <TextView
            android:id="@+id/scoreText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Score: 0"
            android:textColor="#FFB74D"
            android:textSize="16sp"
            android:layout_marginStart="15dp"/>

    </LinearLayout>

    <!-- Progress -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ProgressBar
            android:id="@+id/quizProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:progressTint="#4CAF50"/>

        <TextView
            android:id="@+id/questionCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Question 1/5"
            android:textColor="#B0BEC5"
            android:textSize="12sp"
            android:layout_marginTop="5dp"/>

    </LinearLayout>

    <!-- Question Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Question Type Indicator -->
            <TextView
                android:id="@+id/questionTypeIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Multiple Choice"
                android:textColor="#FFB74D"
                android:textSize="14sp"
                android:background="#1A237E"
                android:padding="5dp"
                android:layout_marginBottom="15sp"/>

            <!-- Question Text -->
            <TextView
                android:id="@+id/questionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Question"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="30dp"/>

            <!-- Multiple Choice Options -->
            <RadioGroup
                android:id="@+id/mcqGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <RadioButton
                    android:id="@+id/option1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Option 1"
                    android:textColor="#FFFFFF"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackground"/>

                <RadioButton
                    android:id="@+id/option2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Option 2"
                    android:textColor="#FFFFFF"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackground"/>

                <RadioButton
                    android:id="@+id/option3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Option 3"
                    android:textColor="#FFFFFF"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackground"/>

                <RadioButton
                    android:id="@+id/option4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Option 4"
                    android:textColor="#FFFFFF"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackground"/>

            </RadioGroup>

            <!-- True/False Options -->
            <RadioGroup
                android:id="@+id/tfGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <RadioButton
                    android:id="@+id/trueOption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="✅ TRUE"
                    android:textColor="#FFFFFF"
                    android:padding="15dp"
                    android:textSize="18sp"
                    android:gravity="center"/>

                <RadioButton
                    android:id="@+id/falseOption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="❌ FALSE"
                    android:textColor="#FFFFFF"
                    android:padding="15dp"
                    android:textSize="18sp"
                    android:gravity="center"/>

            </RadioGroup>

            <!-- Fill in the Blanks -->
            <LinearLayout
                android:id="@+id/fillBlankLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/fillBlankHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Type your answer:"
                    android:textColor="#B0BEC5"
                    android:textSize="14sp"/>

                <EditText
                    android:id="@+id/fillBlankAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter answer here..."
                    android:textColor="#FFFFFF"
                    android:textColorHint="#666666"
                    android:background="@drawable/edit_text_bg"
                    android:padding="15dp"
                    android:layout_marginTop="10dp"/>

            </LinearLayout>

            <!-- Drag and Drop Layout -->
            <LinearLayout
                android:id="@+id/dragDropLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Drag the correct term to the box:"
                    android:textColor="#B0BEC5"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/dragDropSentence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:background="#0D1B2A"
                    android:padding="15dp"
                    android:layout_marginTop="15dp"/>

                <!-- Drop target -->
                <TextView
                    android:id="@+id/dropTarget"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:gravity="center"
                    android:text="___________"
                    android:textColor="#4FC3F7"
                    android:textSize="18sp"
                    android:background="#1A237E"
                    android:layout_marginTop="15dp"/>

                <!-- Drag items -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Available Terms:"
                    android:textColor="#B0BEC5"
                    android:textSize="14sp"
                    android:layout_marginTop="20dp"/>

                <LinearLayout
                    android:id="@+id/dragItemsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"/>

            </LinearLayout>

            <!-- Feedback Section -->
            <androidx.cardview.widget.CardView
                android:id="@+id/feedbackCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#1B5E20">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/feedbackIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✅"
                        android:textSize="24sp"/>

                    <TextView
                        android:id="@+id/feedbackMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:layout_marginTop="5dp"/>

                    <TextView
                        android:id="@+id/explanationMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#B0BEC5"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <Button
            android:id="@+id/nextBtn"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:text="Next Question →"
            android:backgroundTint="#4CAF50"/>

    </LinearLayout>

</LinearLayout>