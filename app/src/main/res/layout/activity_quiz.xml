<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true">

    <!-- Header with Gradient -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/gradient_top_bg"
        android:padding="16dp"
        android:paddingTop="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/quizTopic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Topic"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#33FFFFFF"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <TextView
                    android:id="@+id/heartsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="❤️ ❤️ ❤️"
                    android:textSize="16sp" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Score"
                android:textColor="#E0E7FF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/scoreText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FCD34D"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- Progress Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#F8FAFC">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Quiz Progress"
                android:textColor="#6B7280"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/questionCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Question 1/5"
                android:textColor="#3B82F6"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/quizProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:progressTint="#3B82F6"
            android:progressBackgroundTint="#E5E7EB" />

    </LinearLayout>

    <!-- Question Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="20dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Question Type Indicator -->
            <TextView
                android:id="@+id/questionTypeIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Multiple Choice"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:background="#3B82F6"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:layout_marginBottom="16dp" />

            <!-- Question Text -->
            <TextView
                android:id="@+id/questionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Question"
                android:textColor="#1A1A1A"
                android:textSize="20sp"
                android:textStyle="bold"
                android:lineSpacingExtra="6dp"
                android:layout_marginBottom="24dp" />

            <!-- Multiple Choice Options -->
            <RadioGroup
                android:id="@+id/mcqGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <RadioButton
                    android:id="@+id/option1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Option 1"
                    android:textColor="#1A1A1A"
                    android:textSize="15sp"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp"
                    android:buttonTint="#3B82F6"
                    android:background="#F3F4F6" />

                <RadioButton
                    android:id="@+id/option2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Option 2"
                    android:textColor="#1A1A1A"
                    android:textSize="15sp"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp"
                    android:buttonTint="#3B82F6"
                    android:background="#F3F4F6" />

                <RadioButton
                    android:id="@+id/option3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Option 3"
                    android:textColor="#1A1A1A"
                    android:textSize="15sp"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp"
                    android:buttonTint="#3B82F6"
                    android:background="#F3F4F6" />

                <RadioButton
                    android:id="@+id/option4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Option 4"
                    android:textColor="#1A1A1A"
                    android:textSize="15sp"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp"
                    android:buttonTint="#3B82F6"
                    android:background="#F3F4F6" />

            </RadioGroup>

            <!-- True/False Options -->
            <RadioGroup
                android:id="@+id/tfGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <RadioButton
                    android:id="@+id/trueOption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TRUE"
                    android:textColor="#1A1A1A"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:padding="16dp"
                    android:gravity="center"
                    android:buttonTint="#10B981"
                    android:background="#F3F4F6" />

                <RadioButton
                    android:id="@+id/falseOption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="FALSE"
                    android:textColor="#1A1A1A"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:padding="16dp"
                    android:gravity="center"
                    android:buttonTint="#EF4444"
                    android:background="#F3F4F6" />

            </RadioGroup>

            <!-- Fill in the Blanks -->
            <LinearLayout
                android:id="@+id/fillBlankLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/fillBlankHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Type your answer:"
                    android:textColor="#6B7280"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/fillBlankAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter answer here..."
                    android:textColor="#1A1A1A"
                    android:textColorHint="#9CA3AF"
                    android:background="#F3F4F6"
                    android:padding="16dp" />

            </LinearLayout>

            <!-- Feedback -->
            <androidx.cardview.widget.CardView
                android:id="@+id/feedbackCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/feedbackIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✅"
                        android:textSize="28sp" />

                    <TextView
                        android:id="@+id/feedbackMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#1A1A1A"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/explanationMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#6B7280"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:paddingBottom="30dp"
        android:background="#FFFFFF">

        <Button
            android:id="@+id/nextBtn"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Check Answer →"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/gradient_blue_purple" />

    </LinearLayout>

</LinearLayout>