<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:background="#081120">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🌟 MISSION COMPLETE 🌟"
        android:textSize="30sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/scoreText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Score: 0"
        android:textSize="28sp"
        android:textColor="#4FC3F7"
        android:layout_marginTop="20dp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/xpText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+0 XP"
        android:textSize="24sp"
        android:textColor="#00FFAA"
        android:layout_marginTop="10dp"/>

    <TextView
        android:id="@+id/totalXPText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total XP: 0"
        android:textSize="20sp"
        android:textColor="#B0BEC5"
        android:layout_marginTop="10dp"/>

    <com.airbnb.lottie.LottieAnimationView
        android:layout_width="250dp"
        android:layout_height="250dp"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/success_animation"/>

    <Button
        android:id="@+id/backHomeBtn"
        android:layout_width="200dp"
        android:layout_height="55dp"
        android:text="Back to Home"
        android:layout_marginTop="20dp"
        android:backgroundTint="#4CAF50"/>

</LinearLayout>